{% if settings.dgEnableSearch === true %}
<div class="search-button align-icon" onclick="toggleSearch()">
    <span class="search-icon">
        <i data-lucide="search"></i>
    </span>
    <span class="search-text">{{ "Search" if noteProps and noteProps.lang == "en" else meta.uiStrings.searchButtonText }}</span>
    <span class="search-keys"><code>Ctrl</code>&nbsp;+&nbsp;<code>K</code></span>
</div>
{% endif %}
