{#- Idiomas: cada versión se enlaza a sí misma y a la otra con URL absolutas; x-default = la versión en español. -#}
{%- set _enPage = noteProps and noteProps.lang == "en" -%}
{%- set _baseLang = meta.siteBaseUrl.replace(r/\/+$/, "") -%}
{%- if noteProps and noteProps.translation -%}
{%- set _selfUrl = _baseLang + page.url -%}
{%- set _otherUrl = _baseLang + noteProps.translation -%}
<link rel="alternate" hreflang="{{ 'en' if _enPage else 'es' }}" href="{{ _selfUrl }}">
<link rel="alternate" hreflang="{{ 'es' if _enPage else 'en' }}" href="{{ _otherUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ _otherUrl if _enPage else _selfUrl }}">
{% endif -%}
<link rel="preload" href="/plugins/velardev-minimal/assets/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<script>
/* Pick light/dark before first paint: saved choice, else the system setting. */
(function () {
  try {
    var saved = localStorage.getItem("velardev-theme");
    var theme = saved === "light" || saved === "dark"
      ? saved
      : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    var root = document.documentElement;
    root.setAttribute("data-theme", theme);
    root.style.colorScheme = theme;
    var apply = function () {
      if (!document.body) return false;
      document.body.classList.remove("theme-dark", "theme-light");
      document.body.classList.add("theme-" + theme);
      return true;
    };
    if (!apply()) {
      var observer = new MutationObserver(function () {
        if (apply()) observer.disconnect();
      });
      observer.observe(root, { childList: true });
    }
  } catch (e) {}
})();
</script>

{#- Metadatos para buscadores y vistas previas al compartir (LinkedIn, etc.). -#}
{%- set _en = noteProps and noteProps.lang == "en" -%}
{%- set _home = page.url == "/" or page.url == "/inicio/" or page.url == "/home/" -%}
{%- if _home -%}
  {%- set _titulo = "Víctor Velarde — Product Engineer" -%}
  {%- set _desc = "Product Engineer building AI-powered products. I build software that solves real problems, with a fullstack background and a strong interest in designing interfaces and building products." if _en else "Product Engineer construyendo productos con IA. Construyo software que resuelve problemas reales, con una formación fullstack y gusto por las interfaces y la construcción de producto." -%}
{%- else -%}
  {%- set _titulo = (title or page.fileSlug) + " · Víctor Velarde" -%}
  {%- set _desc = noteProps.description if (noteProps and noteProps.description) else (content | striptags | replace(r/\[\[([^\]|]*\|)?([^\]]*)\]\]/g, "$2") | trim | truncate(155, false, "…")) -%}
{%- endif -%}
{%- set _img = (content | velardevFirstImage) if not _home else "" -%}
{%- if not _img -%}{%- set _img = "/img/user/Blog/Media/Fondo.png" -%}{%- endif -%}
{%- set _base = meta.siteBaseUrl.replace(r/\/+$/, "") -%}
{%- set _imgUrl = (_base + _img) if _img.startsWith("/") else _img -%}
{%- set _url = _base + page.url -%}
<meta name="description" content="{{ _desc | escape }}">
<link rel="canonical" href="{{ _url }}">
<meta property="og:site_name" content="Víctor Velarde">
<meta property="og:locale" content="{{ 'en_US' if _en else 'es_ES' }}">
<meta property="og:type" content="{{ 'website' if _home else 'article' }}">
<meta property="og:title" content="{{ _titulo | escape }}">
<meta property="og:description" content="{{ _desc | escape }}">
<meta property="og:url" content="{{ _url }}">
<meta property="og:image" content="{{ _imgUrl }}">
<meta name="twitter:card" content="summary_large_image">
{#- Datos estructurados (schema.org) solo en la portada: quién soy y cómo se llama el sitio. Los enlaces son los del contacto de Inicio.md / Home.md. -#}
{%- if _home -%}
{%- set _ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": _base + "/#persona",
      "name": "Víctor Velarde",
      "alternateName": "Víctor Velarde Gutiérrez",
      "url": _base + "/",
      "jobTitle": "Senior Software Engineer",
      "worksFor": { "@type": "Organization", "name": "MOGU", "url": "https://www.moguplatform.com/" },
      "description": _desc,
      "knowsAbout": (["Applied AI", "LLMs", "AI agents", "Model Context Protocol (MCP)", "TypeScript", "React", "Cloud architecture", "Geographic information systems (GIS)"] if _en else ["IA aplicada a producto", "LLMs", "Agentes de IA", "Model Context Protocol (MCP)", "TypeScript", "React", "Arquitectura cloud", "Sistemas de información geográfica (SIG)"]),
      "sameAs": ["https://www.linkedin.com/in/victorvelarde/", "https://github.com/VictorVelarde/"]
    },
    {
      "@type": "WebSite",
      "@id": _base + "/#sitio",
      "url": _base + "/",
      "name": "Víctor Velarde",
      "alternateName": "velardev",
      "publisher": { "@id": _base + "/#persona" }
    }
  ]
} -%}
<script type="application/ld+json">{{ _ld | velardevJsonLd | safe }}</script>
{%- endif %}
{#- Cada post: BlogPosting atado a la misma persona (@id) que la portada. Solo con datos que el post ya tiene: sin dateModified porque ningún post lleva fecha de revisión. -#}
{%- if not _home and noteProps and noteProps.date -%}
{%- set _post = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": _url + "#articulo",
  "mainEntityOfPage": { "@type": "WebPage", "@id": _url },
  "headline": (title or page.fileSlug),
  "description": _desc,
  "datePublished": noteProps.date,
  "inLanguage": ("en" if _en else "es"),
  "image": _imgUrl,
  "keywords": ((noteProps.tags | join(", ")) if noteProps.tags else ""),
  "author": { "@type": "Person", "@id": _base + "/#persona", "name": "Víctor Velarde", "url": _base + "/" },
  "publisher": { "@type": "Person", "@id": _base + "/#persona", "name": "Víctor Velarde", "url": _base + "/" },
  "isPartOf": { "@type": "WebSite", "@id": _base + "/#sitio", "url": _base + "/", "name": "Víctor Velarde" }
} -%}
<script type="application/ld+json">{{ _post | velardevJsonLd | safe }}</script>
{#- Migas de pan del post (Inicio > Posts > título), con las URL reales de la portada y del índice. -#}
{%- set _crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": _base + "/" },
    { "@type": "ListItem", "position": 2, "name": "Posts", "item": _base + "/posts/" },
    { "@type": "ListItem", "position": 3, "name": (title or page.fileSlug), "item": _url }
  ]
} -%}
<script type="application/ld+json">{{ _crumbs | velardevJsonLd | safe }}</script>
{%- endif %}
