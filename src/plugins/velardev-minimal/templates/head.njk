{%- if noteProps and noteProps.translation %}<link rel="alternate" hreflang="{{ 'es' if noteProps.lang == 'en' else 'en' }}" href="{{ noteProps.translation }}">{% endif %}
<link rel="preload" href="/plugins/velardev-minimal/assets/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<script>
/* Pick light/dark before first paint: saved choice, else the system setting. */
(function () {
  try {
    var saved = localStorage.getItem("velardev-theme");
    var theme = saved === "light" || saved === "dark"
      ? saved
      : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    var root = document.documentElement;
    root.setAttribute("data-theme", theme);
    root.style.colorScheme = theme;
    var apply = function () {
      if (!document.body) return false;
      document.body.classList.remove("theme-dark", "theme-light");
      document.body.classList.add("theme-" + theme);
      return true;
    };
    if (!apply()) {
      var observer = new MutationObserver(function () {
        if (apply()) observer.disconnect();
      });
      observer.observe(root, { childList: true });
    }
  } catch (e) {}
})();
</script>
