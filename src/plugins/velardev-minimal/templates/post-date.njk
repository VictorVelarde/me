{%- if noteProps and noteProps.date -%}
{%- set _en = noteProps.lang == "en" -%}
<p class="post-date"><time datetime="{{ noteProps.date }}">{{ noteProps.date | velardevFechaCorta(_en) }}</time> · {{ "By" if _en else "Por" }} <a href="{{ '/about/' if _en else '/acerca/' }}" rel="author">Víctor Velarde</a></p>
{%- endif -%}
