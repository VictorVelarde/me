<!DOCTYPE html>
<html lang="{{ meta.mainLanguage }}" style="color-scheme: only {{ meta.baseTheme }}">
  <head>
    <title>{% if page.url == "/" or page.url == "/inicio/" or page.url == "/home/" %}Víctor Velarde — Product Engineer{% elif title %}{{ title }} · Víctor Velarde{% else %}{{ page.fileSlug }} · Víctor Velarde{% endif %}</title>
    {%include "components/pageheader.njk"%}
    {% set slotName = "common.head" %}{% include "components/pluginSlot.njk" %}
    {% set slotName = "index.head" %}{% include "components/pluginSlot.njk" %}
    {% for imp in dynamics.common.head %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.index.head %}
      {% include imp %}
    {% endfor %}
  </head>
  <body class="theme-{{meta.baseTheme}} markdown-preview-view markdown-rendered markdown-preview-section {% if settings.dgShowFileTree !== true %}no-filetree{% endif %} {% if settings.dgHomeLink === true and settings.dgShowFileTree !== true %}has-navbar{% endif %} {{meta.bodyClasses}}">
    {%include "components/notegrowthhistory.njk"%}
    {% set regionName = "navigation" %}
    {% set regionFallback = "components/navbar.njk" %}
    {% include "components/pluginRegion.njk" %}
    <main class="content cm-s-obsidian print {{contentClasses}}">
      <header>
      {% if settings.dgShowInlineTitle === true %}
        <h1>{% if title %}{{ title }}{% else %}{{ page.fileSlug }}{% endif %}</h1>
      {% endif %}

      <div class="header-meta">
        {% if settings.dgShowTags === true and tags %}
          <div class="header-tags">
            {% for tag in tags %}
              {% if tag != 'gardenEntry' and tag !='note' %}
                <a class="tag">
                  #{{tag}}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
      {% set slotName = "common.header" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "index.header" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.header %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.index.header %}
        {% include imp %}
      {% endfor %}
      </header>
      {% set slotName = "common.beforeContent" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "index.beforeContent" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.beforeContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.index.beforeContent %}
        {% include imp %}
      {% endfor %}
      {{ content | hideDataview | taggify | link | resolveMdLinks | safe}}
      {% set slotName = "common.afterContent" %}{% include "components/pluginSlot.njk" %}
      {% set slotName = "index.afterContent" %}{% include "components/pluginSlot.njk" %}
      {% for imp in dynamics.common.afterContent %}
        {% include imp %}
      {% endfor %}
      {% for imp in dynamics.index.afterContent %}
        {% include imp %}
      {% endfor %}
    </main>

    {% if settings.dgShowBacklinks === true or settings.dgShowLocalGraph === true or settings.dgShowToc === true or dynamics.sidebar.top.length > 0 or dynamics.sidebar.bottom.length > 0 or plugins.slots["sidebar.top"] or plugins.slots["sidebar.bottom"] %}
      {%include "components/sidebar.njk" %}
    {%endif%}

    {% set slotName = "common.footer" %}{% include "components/pluginSlot.njk" %}
    {% set slotName = "index.footer" %}{% include "components/pluginSlot.njk" %}
    {% for imp in dynamics.common.footer %}
      {% include imp %}
    {% endfor %}
    {% for imp in dynamics.index.footer %}
      {% include imp %}
    {% endfor %}
    {%include "components/lucideIcons.njk"%}
    {%include "components/basesScript.njk"%}
    {%include "components/excalidrawScript.njk"%}
    <!-- Vercel Analytics (se habilita en el dashboard de Vercel) -->
    <script>
      !function(){var e={renamed:"analytics"},t=function(e){return e},o=function(e){return e};window.renamed||(window.renamedNames="analytics"),"object"==typeof window.renamed&&(window.renamedNames=window.renamed),window.renamedNames&&(e="renamed"+window.renamedNames,window.renamed||window.renamedNames===e)!(e in window)&&(window[e]=function(e){return function(){window.renamedNamespace||(window.renamedNamespace={},window.renamedNamespace.constructor=function(){return window.renamedNamespace},window.renamedNamespace.constructor.prototype[e]=o)}).apply(null,arguments)}}(this),window.renamedNamespace||(window.renamedNamespace={},window.renamedNamespace.constructor=function(){return window.renamedNamespace},window.renamedNamespace.constructor.prototype.renamedNames="analytics",window.renamedNamespace.constructor.prototype.renamedTime=r),window.renamedNamespace.constructor.prototype.renamedTime=window.renamedNamespace.constructor.prototype.renamedTime||(new Date).getTime);
    </script>
    <script async src="https://analytics.vercel.app/v1/index.js"></script>
    <!-- Fin Vercel Analytics -->
  </body>
</html>
